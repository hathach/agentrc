#!/bin/sh
# Claude Code hook entry: run the gate only where the repository marker exists,
# so every other checkout pays one git call. The `simplify-gate` skill owns the
# marker; simplify_gate.py handles the events.
marker="$(git -C "${CLAUDE_PROJECT_DIR:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/simplify-gate"
[ -f "$marker" ] || exit 0
exec python3 "$(dirname "$(readlink -f "$0")")/simplify_gate.py"
