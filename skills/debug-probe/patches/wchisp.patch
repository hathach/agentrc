+++ b/devices/0x29-CH32V4x7.yaml
@@ -0,0 +1,69 @@
+---
+name: CH32V4x7 Series
+mcu_type: 0x19
+device_type: 0x29
+support_net: false
+support_usb: true
+support_serial: true
+description: CH32V407/V467 (QingKe V5F) Dual USB HS and Ethernet Series
+config_registers:
+  # CH32V407RM Rev 1.3, 32.6 User Option Bytes, Table 32-4
+  - offset: 0x00
+    name: RDPR_USER
+    description: RDPR, nRDPR, USER, nUSER
+    # USER = 0xBF keeps RAM_CODE_MOD = 0 (512KB zero-wait code + 200KB RAM)
+    reset: 0x40BF5AA5
+    fields:
+      - bit_range: [7, 0]
+        name: RDPR
+        description: Read Protection. 0xA5 for unprotected, otherwise read-protected(ignoring WRP)
+        explanation:
+          0xa5: Unprotected
+          _: Protected
+      - bit_range: [16, 16]
+        name: IWDG_SW
+        description: Independent watchdog (IWDG) hardware enable
+        explanation:
+          1: IWDG enabled by the software, and disabled by hardware
+          0: IWDG enabled by the hardware (decided along with the LSI clock)
+      - bit_range: [17, 17]
+        name: STOP_RST
+        description: System reset control under the stop mode
+        explanation:
+          1: Disable
+          0: Enable
+      - bit_range: [18, 18]
+        name: STANDBY_RST
+        description: System reset control under the standby mode, STANDY_RST
+        explanation:
+          1: Disable, entering standby-mode without RST
+          0: Enable
+      - bit_range: [22, 22]
+        name: RAM_CODE_MOD
+        description: SRAM Code Mode
+        explanation:
+          1: CODE-576KB + RAM-136KB
+          0: CODE-512KB + RAM-200KB
+  - offset: 0x04
+    name: DATA
+    description: Customizable 2 byte data, DATA0, nDATA0, DATA1, nDATA1
+    reset: 0xFF00FF00
+    type: u32
+    fields:
+      - bit_range: [7, 0]
+        name: DATA0
+      - bit_range: [23, 16]
+        name: DATA1
+  - offset: 0x08
+    name: WRP
+    # Each bit represents 4K bytes to store the write protection status
+    description: Flash memory write protection status
+    type: u32
+    reset: 0xFFFFFFFF
+    explanation:
+      0xFFFFFFFF: Unprotected
+      _: Some 4K sections are protected
+variants:
+  - name: CH32V407WEU6
+    chip_id: 0x71
+    flash_size: 992K
