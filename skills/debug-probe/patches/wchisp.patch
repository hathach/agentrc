diff --git a/src/flashing.rs b/src/flashing.rs
index 7ffb775..12b5b29 100644
--- a/src/flashing.rs
+++ b/src/flashing.rs
@@ -343,6 +343,66 @@ impl<'a> Flashing<'a> {
         Ok(())
     }
 
+    /// Replace one config word on a chip whose layout this was checked against, after confirming the
+    /// chip UID and the word's current value; the rest of the RDPR/USER/DATA/WPR block is written back as read.
+    pub fn set_config_word(&mut self, name: &str, expect_uid: &str, expect: u32, value: u32) -> Result<()> {
+        // (device_type, chip_id, register): CH582 USER_CFG, CH32X035C8T6 RDPR_USER, CH569 NV_INFO
+        const SUPPORTED: &[(u8, u8, &str)] =
+            &[(0x16, 0x82, "USER_CFG"), (0x23, 81, "RDPR_USER"), (0x10, 0x69, "NV_INFO")];
+        anyhow::ensure!(
+            SUPPORTED.contains(&(self.chip.device_type, self.chip.chip_id, name)),
+            "set-word {} is not supported on {}",
+            name,
+            self.chip.name
+        );
+        let uid = self.chip_uid().iter().map(|x| format!("{:02X}", x)).collect::<String>();
+        let want_uid = expect_uid.replace('-', "").to_uppercase();
+        anyhow::ensure!(uid == want_uid, "chip UID {} is not the expected {}", uid, want_uid);
+        let offset = self
+            .chip
+            .config_registers
+            .iter()
+            .find(|r| r.name == name)
+            .ok_or_else(|| anyhow::anyhow!("{} has no {} register", self.chip.name, name))?
+            .offset;
+
+        // CH32X03x refuses a masked read, so read everything, as dump_config does; its first 12 bytes
+        // are the block the 0x07 mask writes
+        let mut raw = self.read_config_block()?;
+        let current = raw.pread_with::<u32>(offset, LE)?;
+        anyhow::ensure!(
+            current == expect,
+            "{} is 0x{:08X}, not the expected 0x{:08X}",
+            name,
+            current,
+            expect
+        );
+
+        raw.pwrite_with(value, offset, LE)?;
+        log::info!("Writing config registers: {}", hex::encode(&raw));
+        let write_conf = Command::write_config(CFG_MASK_RDPR_USER_DATA_WPR, raw.clone());
+        let resp = self.transport.transfer(write_conf)?;
+        anyhow::ensure!(resp.is_ok(), "write_config failed");
+
+        let back = self.read_config_block()?;
+        anyhow::ensure!(
+            back == raw,
+            "readback {} differs from written {}",
+            hex::encode(&back),
+            hex::encode(&raw)
+        );
+        log::info!("{} 0x{:08X} -> 0x{:08X}", name, current, value);
+        Ok(())
+    }
+
+    fn read_config_block(&mut self) -> Result<Vec<u8>> {
+        let resp = self.transport.transfer(Command::read_config(CFG_MASK_ALL))?;
+        anyhow::ensure!(resp.is_ok(), "read_config failed");
+        let payload = resp.payload();
+        anyhow::ensure!(payload.len() >= 14, "config reply is {} bytes", payload.len());
+        Ok(payload[2..14].to_vec())
+    }
+
     pub fn disable_debug(&mut self) -> Result<()> {
         let read_conf = Command::read_config(CFG_MASK_RDPR_USER_DATA_WPR);
         let resp = self.transport.transfer(read_conf)?;
